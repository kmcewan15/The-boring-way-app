# Dependencies and build output. Both are regenerated by `npm install` and
# `npm run build`, and both were tracked for a while -- adding a rule here does
# NOT untrack a file that is already in the index, which is why `dist/` sat in
# this list and in the repo at the same time. Use `git rm -r --cached <path>`.
node_modules/
dist/

# Vite's on-disk dependency cache. Churns on every dev server start.
.vite/

# images/ is deliberately NOT ignored. `publicDir: 'images'` in vite.config.ts
# means the app loads the world backgrounds straight out of that folder at
# runtime, so ignoring it left a fresh clone with no artwork at all. The three
# WebP files are about 2MB in total and belong in the repo.

# Secrets
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Playwright MCP scratch output
.playwright-mcp/

# Superseded copies that only exist on one machine. Not part of the project and
# not worth carrying: node_modules_old/ is a stale install, images_backup_check/
# duplicates art that has since been replaced, and The-boring-way-app/ is a
# second clone of this same GitHub repo with an empty index.
node_modules_old/
images_backup_check/
The-boring-way-app/

# Screenshots and probe images from working sessions, which all landed at the
# repo root. The real artwork lives in images/ (served) and art-source/ (masters).
/*.png
/*.jpeg
/*.svg
